# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_write_token

# Sanity Webhook Revalidation
SANITY_REVALIDATE_SECRET=your_revalidate_secret

# Resend (email notifications for contact form + comments)
RESEND_API_KEY=your_resend_api_key
NOTIFICATION_EMAIL=your@email.com

# MailerLite (newsletter subscriptions)
# Get from: MailerLite Dashboard → Integrations → API → Generate new token
MAILERLITE_API_KEY=your_api_key_here
# Optional: segment-specific group IDs
# MAILERLITE_KITCHEN_GROUP_ID=
# MAILERLITE_MAMA_GROUP_ID=

# Google Analytics 4 (optional; GA disabled when unset)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Shop (Rest and Rise). With STRIPE_SECRET_KEY unset, /shop is the waitlist page.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from registering /api/stripe/webhook in Stripe
# STRIPE_PRICE_BOOK=price_...               # Stripe Price IDs; the page reads prices live
# STRIPE_PRICE_LABELS=price_...             # needed once SHOP_PHASE=launched
# STRIPE_SHIPPING_RATE=shr_...              # optional; a Stripe Shipping Rate for the book
# SHOP_TOKEN_SECRET=                        # 32+ random chars; signs the labels delivery links
# SHOP_PHASE=preorder                       # preorder | launched (a flip needs a redeploy)
# SHOP_SHIP_ESTIMATE=November 2026          # required in preorder (FTC: state the ship date)
# SHOP_SHIP_COUNTRIES=US                    # comma-separated ISO codes offered at checkout
# SHOP_ORDER_NOTIFY=                        # where order emails go; defaults to NOTIFICATION_EMAIL
